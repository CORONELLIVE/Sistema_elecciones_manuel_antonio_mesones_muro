NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# En producción, usar la URL HTTPS pública exacta y ajustar HOST según el servidor.
PUBLIC_ORIGIN=http://127.0.0.1:3000
# 0 con conexión directa. Configurar solo si se controla toda la cadena de proxies.
TRUST_PROXY_HOPS=0
ADMIN_PASSWORD=
DNI_HMAC_KEY=
DNI_PROVIDER=padron
# Clave de Scrall, con o sin el prefijo Basic.
SCRALL_API_KEY=
PERU_CONSULT_ORIGIN=http://127.0.0.1:8080
# Debe coincidir con API_TOKEN del servicio local.
PERU_CONSULT_TOKEN=
# Opcional. Se usa backend/data/votos.mock.json para mock y votos.json para los demás proveedores.
VOTES_FILE=
# Proveedor API: URL HTTPS con {dni} como marcador obligatorio.
DNI_API_URL=
DNI_API_AUTH_HEADER=Authorization
DNI_API_AUTH_VALUE=
DNI_API_NAMES_PATH=nombres
DNI_API_PATERNAL_PATH=apellidoPaterno
DNI_API_MATERNAL_PATH=apellidoMaterno
DNI_API_TIMEOUT_MS=5000
