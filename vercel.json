{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.ts": {"includeFiles": "backend/config/profesores.json", "regions": ["gru1"]}
  },
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/index?__election_path=:path*"},
    {"source": "/admin", "destination": "/index.html"}
  ]
}
